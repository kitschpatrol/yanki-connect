{
	"name": "yanki-connect",
	"version": "5.2.1",
	"description": "Fully-typed AnkiConnect API client.",
	"keywords": [
		"anki",
		"flashcards",
		"spaced-repetition",
		"anki-connect",
		"ankiconnect",
		"client",
		"api",
		"yanki",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/yanki-connect",
	"bugs": "https://github.com/kitschpatrol/yanki-connect/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/yanki-connect.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./standalone": {
			"types": "./dist/standalone/index.d.ts",
			"import": "./dist/standalone/index.js"
		}
	},
	"main": "./dist/index.js",
	"jsdelivr": "./dist/standalone/index.js",
	"unpkg": "./dist/standalone/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown && attw -P --profile esm-only && publint",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"coverage": "node scripts/test.ts --coverage",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "node scripts/test.ts"
	},
	"dependencies": {
		"open": "^11.0.4"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@kitschpatrol/chagent": "^0.5.0",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~22.12.0",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"bumpp": "^12.3.0",
		"execa": "^10.2.1",
		"playwright": "^1.64.1",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"ts-morph": "^28.0.0",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
